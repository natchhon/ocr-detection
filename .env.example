APP_ENV=development
OCR_PROVIDER=chakkhu
OCR_DEVICE=cpu
MODEL_DIR=models
OCR_MIN_CONFIDENCE=0.80
OCR_BATCH_SIZE=16
OCR_BEAM=4
OCR_CTC_WEIGHT=0.5
# Set explicitly after benchmarking. Unset preserves the runtime's thread default.
# OCR_CPU_THREADS=4
IMAGE_PROCESSOR=original
CARD_DETECTOR=none
TEXT_DETECTOR=photo
# Only affects explicitly selected legacy ROI mode; ignored in Photo mode.
# false returns HTTP 422 before inference if card detection/template geometry fails.
OCR_ROI_FALLBACK=true
# ROI requires a calibrated local JSON template AND CARD_DETECTOR=opencv.
# DOCUMENT_TEMPLATE=configs/templates/ais_student_card.json
# AIS coordinates are calibrated to one supplied card; broader accuracy is unverified.
OCR_TEXT_PADDING=0
OCR_MIN_TEXT_HEIGHT=0
MAX_FILE_SIZE=10485760
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_DIMENSION=2400
# Optional business-verified full-match regexes, encoded as JSON. No defaults guessed.
FIELD_PATTERNS={}
CAMPUS_NAMES=[]
SCHOOL_NAMES=["សាលារៀន អន្តរទ្វីប អាមេរិកាំង"]
SCHOOL_NAMES_EN=["American Intercon School"]
